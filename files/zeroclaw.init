#!/bin/sh /etc/rc.common
# Copyright (C) 2026 ZeroClaw Labs
# OpenWrt init script for ZeroClaw daemon

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/zeroclaw

# Directory paths - use user directory by default (~/.zeroclaw)
# Can be overridden via environment variables
# Use /root explicitly as procd may set HOME=/ or HOME is empty
HOME_DIR="/root"
CONFIG_DIR="${ZEROCLAW_CONFIG_DIR:-$HOME_DIR/.zeroclaw}"
DATA_DIR="${ZEROCLAW_DATA_DIR:-$HOME_DIR/.zeroclaw/data}"
LOG_DIR="${ZEROCLAW_LOG_DIR:-$HOME_DIR/.zeroclaw/log}"

# Ensure directories exist
ensure_dirs() {
    mkdir -p "$CONFIG_DIR"
    mkdir -p "$DATA_DIR"
    mkdir -p "$LOG_DIR"

    # Copy default config if it doesn't exist
    if [ ! -f "$CONFIG_DIR/config.toml" ]; then
        cp /etc/zeroclaw/config.toml "$CONFIG_DIR/config.toml"
    fi

    # Set proper permissions (service runs as root)
    chmod 755 "$CONFIG_DIR" "$DATA_DIR" "$LOG_DIR"
}

# Start the service
start_service() {
    ensure_dirs

    # Export environment variables
    export ZEROCLAW_CONFIG_DIR="$CONFIG_DIR"
    export ZEROCLAW_DATA_DIR="$DATA_DIR"
    export ZEROCLAW_LOG_DIR="$LOG_DIR"

    # Debug: log the environment variables
    logger "zeroclaw: ZEROCLAW_CONFIG_DIR=$ZEROCLAW_CONFIG_DIR"
    logger "zeroclaw: ZEROCLAW_DATA_DIR=$ZEROCLAW_DATA_DIR"
    logger "zeroclaw: ZEROCLAW_LOG_DIR=$ZEROCLAW_LOG_DIR"

    procd_open_instance
    procd_set_param command "$PROG" daemon
    procd_set_param env ZEROCLAW_CONFIG_DIR="$CONFIG_DIR"
    procd_set_param env ZEROCLAW_DATA_DIR="$DATA_DIR"
    procd_set_param env ZEROCLAW_LOG_DIR="$LOG_DIR"
    procd_set_param env HOME="$HOME_DIR"

    # Logging
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$CONFIG_DIR/config.toml"
    
    # Resource limits for embedded devices
    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1024"
    procd_set_param respawn 3600 5 0
    
    procd_close_instance
}

# Stop the service
stop_service() {
    # procd will handle stopping
    :
}

# Reload configuration
reload_service() {
    stop
    start
}

# Get service status
service_running() {
    if pgrep -f "zeroclaw daemon" > /dev/null; then
        return 0
    else
        return 1
    fi
}